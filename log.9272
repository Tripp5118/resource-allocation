     \]
   - Opt3:  
     \[
     U_3 = 0.6(0.1321) + 0.4(0.53) \approx 0.0793 + 0.212 = 0.2913
     \]
   - Opt4:  
     \[
     U_4 = 0.6(0.1059) + 0.4(0.34) \approx 0.0635 + 0.136 = 0.1995
     \]
   - Opt5:  
     \[
     U_5 = 0.6(0.0403) + 0.4(0.56) \approx 0.0242 + 0.224 = 0.2482
