# Copy to .env and fill in. Never commit .env.
#
# Needed only by the two LLM-driven strategies, Adaptive-Beta and Rule-Swap,
# which call the model once per BO iteration to choose the exploration/
# exploitation split. Fixed-Mixed and qEHVI run without it.
#
# The model is set per experiment in
# src/resource_allocation/experiments/config.py (agent_model, default gpt-4o).

OPENAI_API_KEY=

# Optional. Set to use an OpenAI-compatible endpoint other than OpenAI's.
# OPENAI_BASE_URL=
